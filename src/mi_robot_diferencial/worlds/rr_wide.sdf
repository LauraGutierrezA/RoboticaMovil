<?xml version="1.0"?>
<sdf version="1.9">
  <world name="rr_wide">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <!-- Bullet en vez de ODE para detectar colisiones: ODE es inestable con mallas de
           triángulos (STL de las pistas) y puede "lanzar" el robot al rozar un muro.
           Si Bullet no está instalado, Gazebo avisa y vuelve a ODE. -->
      <dart><collision_detector>bullet</collision_detector></dart>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>

    <scene>
      <ambient>0.4 0.4 0.5 1</ambient>
      <background>0.01 0.01 0.05 1</background>
    </scene>

    <light type="directional" name="sol">
      <pose>0 0 10 0 0 0</pose>
      <direction>0.3 0.3 -1</direction>
    </light>

    <model name="piso">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.02 0.02 0.06 1</ambient><diffuse>0.02 0.02 0.06 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Rainbow Road, variante rr_wide (isla con ramales ensanchados (0.52 / 0.44 m) + chaflán): vía elevada 5 cm con muros de 20 cm, 9.65 x 9.7 m (STL original en mm, convertido a m)
         Spawn: x=-2.0 y=4.30 z=0.15 yaw=0 (recta superior, encima de la vía de 5 cm) -->
    <model name="rr_wide">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide.stl</uri></mesh></geometry>
        </collision>
        <visual name="vis">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide.stl</uri></mesh></geometry>
          <material><ambient>0.9 0.9 1 1</ambient><diffuse>0.9 0.9 1 1</diffuse><emissive>0.3 0.3 0.4 1</emissive></material>
        </visual>
        <!-- Franjas arcoíris: solo visuales, 1 mm encima de la vía (z = 0.0502-0.0512).
             La colisión sigue siendo la malla original. Generadas con scripts/generar_rainbow.py -->
        <visual name="banda_rojo">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_0.stl</uri></mesh></geometry>
          <material><ambient>1.00 0.10 0.10 1</ambient><diffuse>1.00 0.10 0.10 1</diffuse><emissive>0.45 0.05 0.05 1</emissive></material>
        </visual>
        <visual name="banda_naranja">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_1.stl</uri></mesh></geometry>
          <material><ambient>1.00 0.55 0.00 1</ambient><diffuse>1.00 0.55 0.00 1</diffuse><emissive>0.45 0.25 0.00 1</emissive></material>
        </visual>
        <visual name="banda_amarillo">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_2.stl</uri></mesh></geometry>
          <material><ambient>1.00 0.90 0.00 1</ambient><diffuse>1.00 0.90 0.00 1</diffuse><emissive>0.45 0.41 0.00 1</emissive></material>
        </visual>
        <visual name="banda_verde">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_3.stl</uri></mesh></geometry>
          <material><ambient>0.10 0.85 0.20 1</ambient><diffuse>0.10 0.85 0.20 1</diffuse><emissive>0.05 0.38 0.09 1</emissive></material>
        </visual>
        <visual name="banda_azul">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_4.stl</uri></mesh></geometry>
          <material><ambient>0.10 0.60 1.00 1</ambient><diffuse>0.10 0.60 1.00 1</diffuse><emissive>0.05 0.27 0.45 1</emissive></material>
        </visual>
        <visual name="banda_indigo">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_5.stl</uri></mesh></geometry>
          <material><ambient>0.30 0.20 0.95 1</ambient><diffuse>0.30 0.20 0.95 1</diffuse><emissive>0.14 0.09 0.43 1</emissive></material>
        </visual>
        <visual name="banda_violeta">
          <geometry><mesh><uri>model://mi_robot_diferencial/meshes/pistas/rr_wide/rainbow_6.stl</uri></mesh></geometry>
          <material><ambient>0.70 0.20 0.90 1</ambient><diffuse>0.70 0.20 0.90 1</diffuse><emissive>0.32 0.09 0.41 1</emissive></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
