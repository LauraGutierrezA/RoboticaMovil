<?xml version="1.0"?>
<robot name="robotMicroROS" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Medidas, masas y límites de la tabla del reporte (un solo archivo para los dos modelos) -->
  <xacro:include filename="parametros_microros.xacro"/>

  <!-- ============================================================
       Robot MicroROS con geometría simple (cajas y cilindros): mismas
       medidas generales, marcos, sensores y física que el robot real,
       sin el modelo detallado del fabricante.
         Largo 198.6 mm: chasis (x = -0.0785 … 0.0865) + cabeza de la cámara
                         hasta el lente (x = 0.120)
         Ancho 153 mm:   vía 131.5 mm + llanta de 21.5 mm
         Alto 124.2 mm:  tapa del LiDAR
       Marcos: base_link 0.034 m sobre el piso, ejes de las ruedas 0.01 m
       por debajo de base_link y centrados en x = 0.
       ============================================================ -->
  <xacro:property name="cx" value="0.004"/>        <!-- centro del chasis en x -->
  <xacro:property name="ch_largo" value="0.165"/>
  <xacro:property name="ch_ancho" value="0.108"/>   <!-- sin invadir las llantas (cara interior en y = 0.055) -->
  <xacro:property name="ch_base" value="-0.023"/>  <!-- 11 mm sobre el piso -->
  <xacro:property name="ch_techo" value="0.054"/>

  <xacro:macro name="separador" params="x y">
    <visual>
      <origin xyz="${x} ${y} 0.036" rpy="0 0 0"/>
      <geometry><cylinder radius="0.0025" length="0.028"/></geometry>
      <material name="metal"><color rgba="0.75 0.75 0.78 1"/></material>
    </visual>
  </xacro:macro>

  <!-- Link en el piso: el robot spawnea con las ruedas apoyadas -->
  <link name="base_footprint"/>
  <joint name="joint_base" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${base_altura}" rpy="0 0 0"/>  <!-- radio + 0.01 (las ruedas están 0.01 por debajo del centro del chasis) -->
  </joint>

  <link name="base_link">
    <!-- Cuerpo inferior: motores y batería -->
    <visual>
      <origin xyz="${cx} 0 ${ch_base + 0.0225}" rpy="0 0 0"/>
      <geometry><box size="${ch_largo} ${ch_ancho} 0.045"/></geometry>
      <material name="chasis"><color rgba="0.15 0.15 0.17 1"/></material>
    </visual>
    <!-- 4 separadores -->
    <xacro:separador x="-0.065" y="0.045"/>
    <xacro:separador x="-0.065" y="-0.045"/>
    <xacro:separador x="0.050" y="0.045"/>
    <xacro:separador x="0.050" y="-0.045"/>
    <!-- Placa de control (ESP32-S3), entre el cuerpo y la cubierta -->
    <visual>
      <origin xyz="-0.010 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.088 0.056 0.012"/></geometry>
      <material name="placa"><color rgba="0.05 0.35 0.15 1"/></material>
    </visual>
    <!-- Cubierta superior, donde va el LiDAR; termina antes del PTZ -->
    <visual>
      <origin xyz="${(-0.0785 + 0.060)/2} 0 ${ch_techo - 0.002}" rpy="0 0 0"/>
      <geometry><box size="${0.060 + 0.0785} ${ch_ancho} 0.004"/></geometry>
      <material name="cubierta"><color rgba="0.25 0.25 0.28 1"/></material>
    </visual>
    <!-- Base del PTZ (servo de giro) -->
    <visual>
      <origin xyz="0.075 0 0.028" rpy="0 0 0"/>
      <geometry><box size="0.026 0.030 0.012"/></geometry>
      <material name="ptz"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
    <!-- Colisión: una caja con el tamaño del chasis, sin invadir las ruedas -->
    <collision>
      <origin xyz="${cx} 0 ${(ch_base + ch_techo)/2}" rpy="0 0 0"/>
      <geometry><box size="0.165 0.108 0.077"/></geometry>
    </collision>
    <inertial>
      <origin xyz="${cx} 0 ${(ch_base + ch_techo)/2}" rpy="0 0 0"/>
      <mass value="${masa_chasis}"/>
      <!-- caja maciza del tamaño del chasis: 0.165 x 0.108 x 0.077 m -->
      <xacro:inercia_caja m="${masa_chasis}" x="0.165" y="0.108" z="0.077"/>
    </inertial>
  </link>

  <xacro:macro name="rueda" params="prefijo x_pos y_signo">
    <link name="rueda_${prefijo}">
      <visual>
        <geometry><cylinder radius="${rueda_radio}" length="${rueda_ancho}"/></geometry>
        <material name="llanta"><color rgba="0.08 0.08 0.08 1"/></material>
      </visual>
      <!-- Rayo claro para ver girar la rueda -->
      <visual>
        <geometry><box size="0.040 0.006 ${rueda_ancho + 0.0004}"/></geometry>
        <material name="rin"><color rgba="0.8 0.8 0.8 1"/></material>
      </visual>
      <collision>
        <geometry><sphere radius="${rueda_radio}"/></geometry>
      </collision>
      <inertial>
        <mass value="${masa_rueda}"/>
        <xacro:inercia_rueda/>
      </inertial>
    </link>

    <joint name="joint_rueda_${prefijo}" type="continuous">
      <parent link="base_link"/>
      <child link="rueda_${prefijo}"/>
      <origin xyz="${x_pos} ${y_signo * separacion_ruedas/2} -0.01" rpy="-1.5708 0 0"/>
      <axis xyz="0 0 1"/>
    </joint>
  </xacro:macro>

  <xacro:rueda prefijo="izq_del" x_pos="${distancia_ejes/2}"  y_signo="1"/>
  <xacro:rueda prefijo="izq_tra" x_pos="${-distancia_ejes/2}" y_signo="1"/>
  <xacro:rueda prefijo="der_del" x_pos="${distancia_ejes/2}"  y_signo="-1"/>
  <xacro:rueda prefijo="der_tra" x_pos="${-distancia_ejes/2}" y_signo="-1"/>

  <!-- Skid-steer: en gz-sim se hace con DiffDrive poniendo 2 juntas por lado -->
  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>joint_rueda_izq_del</left_joint>
      <left_joint>joint_rueda_izq_tra</left_joint>
      <right_joint>joint_rueda_der_del</right_joint>
      <right_joint>joint_rueda_der_tra</right_joint>
      <wheel_separation>${separacion_ruedas}</wheel_separation>
      <wheel_radius>${rueda_radio}</wheel_radius>
      <!-- Límites de la tabla: 1.0 m/s, 4.0 rad/s, 2.0 m/s² -->
      <xacro:limites_diffdrive/>
      <odom_publish_frequency>30</odom_publish_frequency>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
  </plugin>
  </gazebo>

<link name="lidar_link">
  <!-- ORBBEC MS200: Ø37.8 x 33 mm sobre la cubierta (z = 0.0572 … 0.0902 en base_link,
       tapa a 124.2 mm del piso). lidar_link = plano de escaneo, a 108 mm del piso (tabla),
       casi en el centro del cuerpo -->
  <visual>
    <!-- desde la cubierta (z = ch_techo) hasta la tapa (z = 0.0902), sin hueco -->
    <origin xyz="0 0 ${(ch_techo + 0.0902)/2 - (lidar_altura - base_altura)}" rpy="0 0 0"/>
    <geometry><cylinder radius="0.0189" length="${0.0902 - ch_techo}"/></geometry>
    <material name="lidar"><color rgba="0.1 0.1 0.1 1"/></material>
  </visual>
  <collision>
    <origin xyz="0 0 ${0.0737 - (lidar_altura - base_altura)}" rpy="0 0 0"/>
    <geometry><cylinder radius="0.0189" length="0.033"/></geometry>
  </collision>
  <inertial><mass value="${masa_lidar}"/><inertia ixx="0.0000072" ixy="0" ixz="0" iyy="0.0000072" iyz="0" izz="0.0000071"/></inertial>
</link>
<joint name="joint_lidar" type="fixed">
  <parent link="base_link"/>
  <child link="lidar_link"/>
  <origin xyz="0.002 0 ${lidar_altura - base_altura}" rpy="0 0 0"/>  <!-- plano de escaneo a 108 mm del piso (tabla) -->
</joint>

<link name="camera_link">
  <!-- Cabeza del PTZ con la cámara: caja de 52 x 58 x 30 mm detrás del lente.
       Su techo queda a 98 mm del piso, 10 mm por debajo del plano del LiDAR, para que
       el LiDAR no la vea (con el modelo detallado quedaba a solo 0.7 mm). -->
  <visual>
    <origin xyz="-0.028 0 0.0005" rpy="0 0 0"/>
    <geometry><box size="0.052 0.058 0.030"/></geometry>
    <material name="ptz"><color rgba="0.9 0.9 0.9 1"/></material>
  </visual>
  <visual>
    <origin xyz="-0.002 0 0" rpy="0 1.5708 0"/>
    <geometry><cylinder radius="0.007" length="0.004"/></geometry>
    <material name="lente"><color rgba="0.05 0.05 0.1 1"/></material>
  </visual>
  <collision>
    <origin xyz="-0.028 0 0.0005" rpy="0 0 0"/>
    <geometry><box size="0.052 0.058 0.030"/></geometry>
  </collision>
  <inertial><mass value="${masa_camara}"/><inertia ixx="0.0000052" ixy="0" ixz="0" iyy="0.0000019" iyz="0" izz="0.0000039"/></inertial>
</link>
<joint name="joint_camera" type="fixed">
  <parent link="base_link"/>
  <child link="camera_link"/>
  <origin xyz="0.120 0 0.0485" rpy="0 0 0"/>  <!-- frente del lente: largo total 198.6 mm -->
</joint>


<!-- Antena (solo por el visaje) -->
<link name="antena_link">
  <!-- sin visual (sobresaldría de las medidas de la tabla): se deja solo por el TF -->
  <inertial><mass value="${masa_antena}"/><inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/></inertial>
</link>
<joint name="joint_antena" type="fixed">
  <parent link="base_link"/>
  <child link="antena_link"/>
  <origin xyz="-0.09 -0.045 0.03" rpy="0 0 0"/>
</joint>



  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <gz_frame_id>lidar_link</gz_frame_id> <!-- sin esto el frame_id sería "lidar" -->
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <lidar>
        <scan>
          <horizontal>
            <samples>450</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.03</min>
          <max>12.0</max>
        </range>
        <noise> <!-- Agregamos porque la ds menciona precisión de ±4 mm hasta 2 m y ±15 mm de 2 a 12 m.-->
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camara" type="camera">
      <gz_frame_id>camera_link</gz_frame_id> <!-- también lo agregamos para que el frame_id que publica el sensor sea "camera_link" y no "camara" -->
      <topic>image_raw</topic>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>20</far></clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

  



  <!-- Ground truth: pose REAL del robot leída del motor de física (no de las ruedas).
       Solo para medir el error de cierre y los tiempos por vuelta (detector_vueltas.py);
       ningún controlador la usa. Se publica en /ground_truth; su TF va a un tópico aparte
       para no chocar con el TF odom -> base_footprint del DiffDrive. -->
  <gazebo>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_topic>ground_truth</odom_topic>
      <tf_topic>ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>  <!-- 3D: la pista_pro tiene puente -->
    </plugin>
  </gazebo>

</robot>
